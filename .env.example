# Cashfree Payment Gateway Credentials
# For Vercel / Production:
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox # or 'production'

# WhatsApp Business Cloud API Credentials (Meta Developer Portal)
# Get from Meta Developers -> Your App -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

